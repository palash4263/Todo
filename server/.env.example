MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/todo?retryWrites=true&w=majority
PORT=5000
# Comma-separated allowed origins, e.g. http://localhost:5173,https://your-app.netlify.app (no trailing slash). * allows any.
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development
# Optional: set if startup fails with "querySrv ECONNREFUSED" (Node using a DNS server that refuses SRV lookups)
# DNS_SERVERS=8.8.8.8,1.1.1.1
